# 复制本文件为 .env.local，并填入你自己的真实 API Key（.env.local 不会提交到 git）

# 阿里云 DashScope（百炼）API Key —— 两个模型共用同一个 key
# 申请地址：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 可选：DashScope 区域 base_url，不填默认华北2（北京）
# 新加坡: https://dashscope-intl.aliyuncs.com/apps/anthropic
# 美国:   https://dashscope-us.aliyuncs.com/apps/anthropic
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
