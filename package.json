{
  "name": "llm-eval-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run langgraph:build",
    "dev": "next dev",
    "prebuild": "npm run langgraph:build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "langgraph:build": "tsc -p tsconfig.langgraph.json",
    "pretest:unit": "npm run mcp:build && npm run langgraph:build",
    "test:unit": "vitest run tests/unit",
    "test:stress": "vitest run tests/stress",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "security:secrets": "node scripts/scanSecrets.mjs",
    "quality": "npm run security:secrets && npm run lint && npm run typecheck && npm run test:unit && npm run test:stress && npm run build"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "antd": "6.6.2",
    "dexie": "^4.4.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "xlsx": "^0.18.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
