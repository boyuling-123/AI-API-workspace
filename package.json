{
  "name": "llm-eval-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:stress": "vitest run tests/stress",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "security:secrets": "node scripts/scanSecrets.mjs",
    "quality": "npm run security:secrets && npm run lint && npm run typecheck && npm run test:unit && npm run test:stress && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
